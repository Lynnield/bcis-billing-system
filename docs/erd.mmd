    APPLICATION_SETTINGS {
        varchar key PK
        text value
        timestamptz updated_at
        bigint updated_by_user_id FK
    }
    AUDIT_LOGS {
        bigserial id PK
        bigint actor_user_id FK
        varchar action
        varchar entity_type
        bigint entity_id
        jsonb metadata
        varchar ip_address
        timestamptz created_at
    }
    BACKUP_HISTORY {
        bigserial id PK
        varchar filename
        bigint size_bytes
        varchar checksum_sha256
        backup_status status
        bigint created_by_user_id FK
        timestamptz created_at
        timestamptz verified_at
        timestamptz restored_at
        bigint restored_by_user_id FK
    }
    BILLING_PERIODS {
        bigserial id PK
        varchar label UK
        date period_start
        date period_end
        date due_date
        timestamptz created_at
    }
    COLLECTION_AREAS {
        bigserial id PK
        varchar name UK
        text description
        record_status status
        timestamptz created_at
    }
    COLLECTION_BATCH_ACCOUNTS {
        bigserial id PK
        bigint batch_id FK
        bigint service_account_id FK
        numeric balance_due
    }
    COLLECTION_BATCH_PAYMENTS {
        bigint batch_id FK
        bigint payment_id FK, UK
    }
    COLLECTION_BATCHES {
        bigserial id PK
        bigint collector_id FK
        date batch_date
        collection_batch_status status
        numeric expected_amount
        numeric remitted_amount
        numeric shortage_amount
        numeric overage_amount
        text reconciliation_notes
        numeric expected_receivable
        timestamptz submitted_at
        timestamptz reconciled_at
        bigint reconciled_by_user_id FK
        timestamptz closed_at
        bigint closed_by_user_id FK
        text closing_notes
        timestamptz created_at
        timestamptz updated_at
    }
    COLLECTORS {
        bigserial id PK
        bigint user_id FK
        varchar full_name
        varchar contact_number
        bigint collection_area_id FK
        record_status status
        timestamptz created_at
        timestamptz updated_at
    }
    GCASH_PAYMENT_DETAILS {
        bigserial id PK
        bigint payment_id FK, UK
        varchar gcash_reference_number UK
        varchar proof_attachment_path
        gcash_verification_status verification_status
        bigint verified_by_user_id FK
        timestamptz verified_at
        text verification_note
        timestamptz created_at
        timestamptz updated_at
    }
    INVOICE_ADJUSTMENTS {
        bigserial id PK
        bigint invoice_id FK
        adjustment_type type
        numeric amount
        text reason
        boolean post_issue
        bigint created_by_user_id FK
        timestamptz created_at
    }
    INVOICE_LINE_ITEMS {
        bigserial id PK
        bigint invoice_id FK
        varchar description
        integer quantity
        numeric unit_price
        numeric amount
        timestamptz created_at
    }
    INVOICES {
        bigserial id PK
        varchar invoice_number UK
        bigint service_account_id FK
        bigint billing_period_id FK
        date issue_date
        date due_date
        invoice_status status
        numeric total_amount
        text void_reason
        bigint voided_by_user_id FK
        timestamptz voided_at
        timestamptz finalized_at
        timestamptz created_at
        timestamptz updated_at
    }
    PAYMENT_ALLOCATIONS {
        bigserial id PK
        bigint payment_id FK
        bigint invoice_id FK
        numeric amount
        timestamptz created_at
    }
    PAYMENT_PROOFS {
        bigserial id PK
        bigint payment_id FK
        varchar stored_name UK
        varchar original_name
        varchar mime_type
        integer size_bytes
        varchar sha256
        bigint uploaded_by_user_id FK
        timestamptz created_at
    }
    PAYMENT_REVERSALS {
        bigserial id PK
        bigint payment_id FK, UK
        text reason
        bigint reversed_by_user_id FK
        timestamptz reversed_at
    }
    PAYMENTS {
        bigserial id PK
        bigint service_account_id FK
        payment_method method
        numeric amount
        date payment_date
        varchar receipt_number UK
        varchar reference_number
        varchar proof_attachment_path
        payment_status status
        bigint posted_by_user_id FK
        timestamptz posted_at
        timestamptz created_at
        timestamptz updated_at
    }
    PERMISSIONS {
        bigserial id PK
        varchar code UK
        varchar group_name
        text description
        timestamptz created_at
    }
    RECONNECTION_RECORDS {
        bigserial id PK
        bigint service_account_id FK
        numeric fee
        bigint technician_user_id FK
        timestamptz request_date
        timestamptz completion_date
        reconnection_status status
        text notes
        bigint requested_by_user_id FK
        bigint completed_by_user_id FK
        bigint billed_invoice_id FK
        timestamptz created_at
    }
    ROLE_PERMISSIONS {
        bigint role_id FK
        bigint permission_id FK
        timestamptz granted_at
    }
    ROLES {
        bigserial id PK
        varchar name UK
        text description
        timestamptz created_at
    }
    SERVICE_ACCOUNTS {
        bigserial id PK
        bigint subscriber_id FK
        bigint plan_id FK
        varchar service_number UK
        varchar installation_address
        date billing_start_date
        integer billing_due_day
        numeric current_rate
        service_account_status status
        bigint collection_area_id FK
        bigint assigned_collector_id FK
        timestamptz activated_at
        timestamptz created_at
        timestamptz updated_at
    }
    SERVICE_PLANS {
        bigserial id PK
        bigint service_id FK
        varchar code UK
        varchar name
        text description
        numeric price
        numeric installation_fee
        numeric reconnection_fee
        integer speed_mbps
        integer channel_count
        record_status status
        timestamptz created_at
        timestamptz updated_at
    }
    SERVICES {
        bigserial id PK
        service_type type
        varchar name UK
        text description
        record_status status
        timestamptz created_at
        timestamptz updated_at
    }
    SUBSCRIBER_STATUS_HISTORY {
        bigserial id PK
        bigint subscriber_id FK
        subscriber_status old_status
        subscriber_status new_status
        bigint changed_by_user_id FK
        text note
        timestamptz created_at
    }
    SUBSCRIBERS {
        bigserial id PK
        varchar account_number UK
        varchar first_name
        varchar last_name
        varchar contact_number
        varchar email
        varchar address_line1
        varchar address_line2
        varchar city
        varchar province
        varchar postal_code
        text notes
        subscriber_status status
        timestamptz created_at
        timestamptz updated_at
    }
    SUSPENSION_RECORDS {
        bigserial id PK
        bigint service_account_id FK
        text reason
        timestamptz effective_date
        bigint approved_by_user_id FK
        text notes
        timestamptz created_at
    }
    USER_ROLES {
        bigint user_id FK
        bigint role_id FK
        timestamptz assigned_at
    }
    USERS {
        bigserial id PK
        varchar username UK
        varchar email UK
        varchar full_name
        text password_hash
        user_status status
        timestamptz last_login_at
        integer failed_login_count
        timestamptz locked_until
        timestamptz created_at
        timestamptz updated_at
    }
